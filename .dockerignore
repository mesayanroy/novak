# Keep the build context small and secret-free.
**/node_modules
**/.next
**/.next-check
**/dist
**/out
**/.turbo
**/*.tsbuildinfo
cache/
out/
broadcast/
lib/
novak/
.git
.github
.vscode
.idea

# Secrets and local state never go into an image.
.env
.env.*
!.env.example
**/.env.local
.resolver-evidence/
*.log
.multi-test.log
.next-dev.log
