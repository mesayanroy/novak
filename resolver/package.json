{
  "name": "novak-resolver",
  "version": "0.1.0",
  "private": true,
  "description": "Novak resolver node: fetches source data via adapters, packages evidence, and participates in quorum for event resolution.",
  "type": "module",
  "main": "dist/node/index.js",
  "scripts": {
    "dev": "tsx watch node/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/node/index.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "probe": "tsx scripts/probe-sources.ts",
    "list-markets": "tsx scripts/list-markets.ts",
    "start:multi": "node dist/node/multi.js"
  },
  "dependencies": {
    "@novakoracle/sdk": "workspace:*",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
