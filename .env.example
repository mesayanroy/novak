# --- Chain / RPC ---
RPC_URL_LOCAL=http://127.0.0.1:8545
RPC_URL_TESTNET=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# --- Deployment ---
# NEVER commit a real private key. Use a throwaway testnet key only.
DEPLOYER_PRIVATE_KEY=0xyour_testnet_private_key_here
ETHERSCAN_API_KEY=

# --- Deployed addresses (filled in after script/Deploy.s.sol runs — see its
# console.log output) ---
EVENT_REGISTRY_ADDRESS=
EVENT_BUS_ADDRESS=
EVENT_COMPOSER_ADDRESS=
SUBSCRIPTION_MANAGER_ADDRESS=
SETTLEMENT_ADDRESS=
POSITION_MANAGER_ADDRESS=
MARKET_ADDRESS=

# --- Resolver node ---
RESOLVER_ID=resolver-local-1
# Must be an address the Registry owner has authorized via
# setResolverAuthorization(address, true) before it can submit observations.
RESOLVER_PRIVATE_KEY=0xyour_resolver_signing_key_here
RESOLVER_POLL_INTERVAL_MS=15000
# Comma-separated event IDs this resolver watches (no on-chain event
# discovery/indexer in the MVP — see resolver/README.md).
RESOLVER_WATCHED_EVENT_IDS=

# --- Example price-feed adapter (placeholder source, see
# resolver/adapters/priceFeedAdapter.ts) ---
PRICE_FEED_THRESHOLD=5000
PRICE_FEED_MOCK_PRICE=0

# --- Frontend (Next.js public env) ---
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EVENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_EVENT_COMPOSER_ADDRESS=
NEXT_PUBLIC_SUBSCRIPTION_MANAGER_ADDRESS=
NEXT_PUBLIC_EVENT_BUS_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_ADDRESS=
NEXT_PUBLIC_POSITION_MANAGER_ADDRESS=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
