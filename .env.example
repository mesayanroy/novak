# --- Chain / RPC ---
# Novak deploys to Robinhood Chain TESTNET (46630). Mainnet (4663) is only
# READ from, by resolvers, as a free data source (Chainlink stock feeds,
# ERC-8056 stock tokens) — see docs/ROBINHOOD_CHAIN_PLAN.md §0.
RPC_URL_LOCAL=http://127.0.0.1:8545
RPC_URL_ROBINHOOD_TESTNET=https://rpc.testnet.chain.robinhood.com
# Read-only data source for resolvers (public endpoint is rate-limited; an
# Alchemy URL is better: https://robinhood-mainnet.g.alchemy.com/v2/<key>)
RESOLVER_SOURCE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Testnet ETH: https://faucet.testnet.chain.robinhood.com
# Fed rates (macro.fomc.v1 adapter, /api/rates) use FRED's public CSV and the
# NY Fed API — no API keys needed.

# --- Deployment (script/Deploy.s.sol) ---
# NEVER commit a real private key. Use a throwaway testnet key only.
DEPLOYER_PRIVATE_KEY=0xyour_testnet_private_key_here
# Owner of the TreasuryVault (receives every market fee and the treasury
# third of forfeited dispute bonds, splits fees into thirds per event). Can
# spend the treasury / insurance balances. Defaults to the deployer.
VAULT_OWNER=
# Can add StockLendingGuard risk rules. Defaults to the deployer.
RISK_ADMIN_ADDRESS=
# Comma-separated resolver addresses authorized during deployment.
RESOLVER_ADDRESSES=
# Leave empty on testnet to deploy MockUSDG. REQUIRED on mainnet (real USDG:
# 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168).
COLLATERAL_TOKEN_ADDRESS=
# Protocol fee on the losing pool at settlement, in bps (max 500).
MARKET_FEE_BPS=100
# DistributionMarket fee on every buy/sell, in bps (max 500).
TRADE_FEE_BPS=100
# After deploying: node script/export-deployment.mjs 46630
# -> deployments/46630.json, which the SDK/resolver/frontend read. No need
# to copy contract addresses into env vars.

# --- Resolver node ---
RESOLVER_ID=resolver-1
# Must be authorized by the Registry owner (RESOLVER_ADDRESSES above, or
# setResolverAuthorization(address, true)).
RESOLVER_PRIVATE_KEY=0xyour_resolver_signing_key_here
RESOLVER_POLL_INTERVAL_MS=15000
# Chain the resolver WRITES to (46630 testnet, 31337 local anvil).
NOVAK_CHAIN_ID=46630

# --- Frontend (Next.js public env) ---
# TESTNET only — never set these to mainnet (4663) values; Novak has no
# mainnet deployment (see CLAUDE.md). Verified against
# docs.robinhood.com/chain/connecting.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Optional: the public RPC above is rate-limited and "not recommended for
# production use" per the docs, which recommend Alchemy. Set this to use
# https://robinhood-testnet.g.alchemy.com/v2/<key> instead.
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Required for WalletConnect — and therefore for Robinhood Wallet, which
# connects to dapps via WalletConnect. Get one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
